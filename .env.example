# AdjudicaUY — environment variables
#
# Copy this file to ``.env`` and fill in the real values for local
# development. In production, Dokploy injects these variables directly
# via its environment management, so a ``.env`` file is NOT needed in
# the deployed container.
#
# Required variables are marked with `# REQUIRED`. Variables with a
# sensible default for production are marked with `# OPTIONAL`.

# ---------------------------------------------------------------------------
# Database (managed by Dokploy)
# ---------------------------------------------------------------------------
# REQUIRED — SQLAlchemy URL for the PostgreSQL database.
#
# Use the internal Dokploy hostname of the postgres service (typically
# the service name in your Dokploy project, e.g. ``dokploy-postgres``).
# Local development against a host-installed Postgres can use
# ``localhost`` instead.
#
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://adjudicauy:CHANGE_ME@dokploy-postgres:5432/adjudicauy

# ---------------------------------------------------------------------------
# Scraping sources
# ---------------------------------------------------------------------------
# REQUIRED — Base URL of the XML adjudication report (source A), WITHOUT
# the ``dia_inicial/mes_inicial/.../hora_final`` query parameters — the
# scraper appends them on every run from the date range passed to
# ``run_scrape(start_date=..., end_date=...)``. Default in production:
# http://www.comprasestatales.gub.uy/comprasenlinea/jboss/generarReporte
SOURCE_A_BASE_URL=https://example.com/path/to/xml_report

# REQUIRED — Base URL of the RSS feed (source B), used to enrich
# adjudications with the organism name and the public detail-page link.
# The base URL ends at the ``rango-fecha`` path segment — the scraper
# appends ``/<start>_<end>/filtro-cat/CAT/tipo-orden/DESC`` from the
# date range. Default in production:
# https://www.comprasestatales.gub.uy/consultas/rss/tipo-pub/ADJ/tipo-doc/C/tipo-fecha/PUB/rango-fecha
SOURCE_B_BASE_URL=https://example.com/path/to/rss_feed

# ---------------------------------------------------------------------------
# External services
# ---------------------------------------------------------------------------
# REQUIRED — BCU (Banco Central del Uruguay) SOAP endpoint for currency
# conversion. The default value below is the production endpoint and can
# be left as-is.
BCU_API_URL=https://cotizaciones.bcu.gub.uy/wscotizaciones/servlet/awsbcucotizaciones
