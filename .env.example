# AdjudicaUY — environment variables
#
# Copy this file to ``.env`` and fill in the real values.
# Docker Compose reads this file automatically.
#
# For Dokploy: copy this file to the server and rename it to .env.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=adjudicauy
POSTGRES_HOST=db

# ---------------------------------------------------------------------------
# Scraping sources
# ---------------------------------------------------------------------------
# REQUIRED — Base URL of the XML adjudication report (source A), WITHOUT
# the ``dia_inicial/mes_inicial/.../hora_final`` query parameters — the
# scraper appends them on every run from the date range passed to
# ``run_scrape(start_date=..., end_date=...)``.
# The scraper requires HTTPS by default. Only set ALLOW_HTTP_SOURCE_URL=true
# if the upstream endpoint genuinely does not support TLS.
SOURCE_A_BASE_URL=https://www.comprasestatales.gub.uy/comprasenlinea/jboss/generarReporte
ALLOW_HTTP_SOURCE_URL=false

# ---------------------------------------------------------------------------
# External services
# ---------------------------------------------------------------------------
# REQUIRED — BCU (Banco Central del Uruguay) exchange rate API.
BCU_API_URL=https://cotizaciones.bcu.gub.uy/wscotizaciones/servlet/awsbcucotizaciones

# ---------------------------------------------------------------------------
# SEO / site identity
# ---------------------------------------------------------------------------
# Public base URL of the site, used for canonical URLs, OG tags, and sitemap.
# Defaults to http://localhost:8000 for local dev. Set in production to your
# real domain (e.g. https://adjudicauy.duckdns.org).
# SITE_URL=https://adjudicauy.duckdns.org

# ---------------------------------------------------------------------------
# IndexNow (optional — the feature is off unless a key is set)
# ---------------------------------------------------------------------------
# When set, the worker tells IndexNow (Bing, Yandex, Seznam) which pages a
# successful scrape changed, and the app serves the key at /{INDEXNOW_KEY}.txt so
# the endpoint can verify the domain. Leave it unset, or blank, to keep the
# feature off: nothing is submitted and no key file is served.
# 8-128 characters from [A-Za-z0-9-]. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(16))"
# The key becomes publicly readable at /{key}.txt BY DESIGN — IndexNow has to
# fetch it to prove the domain is yours.
# INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# NOTE — setting a variable here does not by itself reach a container
# ---------------------------------------------------------------------------
# docker-compose.yml passes the environment by explicit allowlist, not env_file:
# each container receives only the variables named in its own `environment`
# block. IndexNow needs a line in BOTH `app` and `worker` (the web app serves the
# key file, the worker submits the URLs). A variable documented here but missing
# from those blocks is silently ignored inside the container.
# tests/test_compose_contract.py fails whenever the two drift apart.
